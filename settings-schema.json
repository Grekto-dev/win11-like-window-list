{
    "layout1": {
        "type": "layout",
        "pages": ["general", "monitors", "flyout", "extras"],
        "general": {
            "type": "page",
            "title": "General",
            "sections": ["general-language", "general-look", "general-windows"]
        },
        "monitors": {
            "type": "page",
            "title": "Monitors",
            "sections": ["monitors-sync"]
        },
        "flyout": {
            "type": "page",
            "title": "Hover and animations",
            "sections": ["flyout-hover", "flyout-peek", "flyout-drag", "flyout-anim"]
        },
        "extras": {
            "type": "page",
            "title": "Jump list and badges",
            "sections": ["extras-jump", "extras-badges"]
        },
        "general-language": {
            "type": "section",
            "title": "Language",
            "keys": ["language"]
        },
        "general-look": {
            "type": "section",
            "title": "Icons",
            "keys": ["icon-size-mode", "icon-size", "indicator-color"]
        },
        "general-windows": {
            "type": "section",
            "title": "Windows",
            "keys": ["show-all-workspaces", "super-num-hotkeys"]
        },
        "monitors-sync": {
            "type": "section",
            "title": "Several monitors",
            "keys": ["sync-monitors", "show-all-monitors"]
        },
        "flyout-hover": {
            "type": "section",
            "title": "Hover cards",
            "keys": ["hover-cards", "hover-delay", "show-previews", "show-tooltips"]
        },
        "flyout-peek": {
            "type": "section",
            "title": "Peek",
            "keys": ["enable-peek", "peek-mode", "peek-delay"]
        },
        "flyout-drag": {
            "type": "section",
            "title": "Dragging a file over a button",
            "keys": ["xdnd-hover", "xdnd-delay"]
        },
        "flyout-anim": {
            "type": "section",
            "title": "Animations",
            "keys": ["enable-animations", "animate-highlight", "animate-buttons", "animate-cards", "pulse-attention", "launch-animation"]
        },
        "extras-jump": {
            "type": "section",
            "title": "Jump list (right click)",
            "keys": ["show-recent", "recent-count"]
        },
        "extras-badges": {
            "type": "section",
            "title": "Button decorations",
            "keys": ["show-badges", "show-progress", "launcher-api"]
        }
    },
    "pinned-apps": {
        "type": "generic",
        "default": []
    },
    "pinned-imported": {
        "type": "generic",
        "default": false
    },
    "language": {
        "type": "combobox",
        "default": "en",
        "description": "Language of the applet and its settings",
        "tooltip": "The settings window uses the new language the next time it is opened.",
        "options": {
            "English": "en",
            "Português (Brasil)": "pt-BR"
        }
    },
    "show-all-workspaces": {
        "type": "switch",
        "default": false,
        "description": "Show windows from all workspaces"
    },
    "show-all-monitors": {
        "type": "switch",
        "default": true,
        "description": "Show windows from all monitors (off: only this monitor's windows)",
        "dependency": "!sync-monitors"
    },
    "sync-monitors": {
        "type": "switch",
        "default": true,
        "description": "Synchronise monitors: every bar with this option shows the same windows, order and pinned apps",
        "tooltip": "Use when the applet is on the panels of more than one monitor."
    },
    "super-num-hotkeys": {
        "type": "switch",
        "default": true,
        "description": "Super+1…9 activates the Nth button (Super+Shift+N opens a new window)"
    },
    "icon-size-mode": {
        "type": "combobox",
        "default": "auto",
        "description": "Icon size",
        "options": {
            "Automatic (follows the taskbar size)": "auto",
            "Manual": "manual"
        }
    },
    "icon-size": {
        "type": "spinbutton",
        "default": 24,
        "min": 16,
        "max": 128,
        "step": 2,
        "units": "px",
        "description": "Manual icon size (at most the taskbar size)",
        "dependency": "icon-size-mode=manual"
    },
    "indicator-color": {
        "type": "colorchooser",
        "default": "rgb(76,194,255)",
        "description": "Accent colour of the focused-window indicator"
    },
    "hover-cards": {
        "type": "switch",
        "default": true,
        "description": "Show the window cards when hovering a button",
        "tooltip": "When off, hovering a button only shows the app name; click a button with several windows to see its cards."
    },
    "hover-delay": {
        "type": "spinbutton",
        "default": 400,
        "min": 0,
        "max": 2000,
        "step": 50,
        "units": "ms",
        "description": "Delay before the cards open",
        "dependency": "hover-cards"
    },
    "show-previews": {
        "type": "switch",
        "default": true,
        "description": "Show a thumbnail of each window in the cards",
        "tooltip": "When off, the cards are compact rows with the app icon and the window title."
    },
    "show-tooltips": {
        "type": "switch",
        "default": true,
        "description": "Show the app name in a tooltip when hovering a button without cards"
    },
    "xdnd-hover": {
        "type": "switch",
        "default": true,
        "description": "Bring a window forward when a dragged file is held over its button"
    },
    "xdnd-delay": {
        "type": "spinbutton",
        "default": 400,
        "min": 100,
        "max": 2000,
        "step": 50,
        "units": "ms",
        "description": "Delay before bringing a window forward while dragging an item over it",
        "dependency": "xdnd-hover"
    },
    "enable-peek": {
        "type": "switch",
        "default": true,
        "description": "Peek at a window while hovering its thumbnail"
    },
    "peek-mode": {
        "type": "combobox",
        "default": "isolate",
        "description": "Peek style",
        "tooltip": "Only the window: the other windows fade away and the window appears alone over the desktop. Above the others: nothing is hidden and the window is drawn over whatever is on screen.",
        "options": {
            "Only the window (others are hidden)": "isolate",
            "Above the other windows": "overlay"
        },
        "dependency": "enable-peek"
    },
    "peek-delay": {
        "type": "spinbutton",
        "default": 400,
        "min": 0,
        "max": 2000,
        "step": 50,
        "units": "ms",
        "description": "Delay before peeking",
        "dependency": "enable-peek"
    },
    "enable-animations": {
        "type": "switch",
        "default": true,
        "description": "Animate buttons, indicators and flyouts"
    },
    "animate-highlight": {
        "type": "switch",
        "default": true,
        "description": "Fade button highlights and indicators",
        "dependency": "enable-animations"
    },
    "animate-buttons": {
        "type": "switch",
        "default": true,
        "description": "Animate buttons opening, closing and moving",
        "dependency": "enable-animations"
    },
    "animate-cards": {
        "type": "switch",
        "default": true,
        "description": "Animate the cards, tooltips and the jump list",
        "dependency": "enable-animations"
    },
    "pulse-attention": {
        "type": "switch",
        "default": true,
        "description": "Pulse buttons that ask for attention",
        "tooltip": "When off, they stay lit instead of pulsing.",
        "dependency": "enable-animations"
    },
    "launch-animation": {
        "type": "switch",
        "default": true,
        "description": "Bounce the icon while an app is launching",
        "dependency": "enable-animations"
    },
    "show-recent": {
        "type": "switch",
        "default": true,
        "description": "Show recent files in the jump list (follows the system privacy setting)"
    },
    "recent-count": {
        "type": "spinbutton",
        "default": 5,
        "min": 1,
        "max": 12,
        "step": 1,
        "description": "Recent files shown",
        "dependency": "show-recent"
    },
    "show-badges": {
        "type": "switch",
        "default": true,
        "description": "Show the notification count on the button"
    },
    "launcher-api": {
        "type": "switch",
        "default": true,
        "description": "Accept counts, progress and alerts that apps send to the launcher",
        "tooltip": "Used by Chrome downloads, file managers and others. Window progress and system notification counts do not depend on it."
    },
    "show-progress": {
        "type": "switch",
        "default": true,
        "description": "Show a progress bar on the button while an app reports progress"
    }
}
